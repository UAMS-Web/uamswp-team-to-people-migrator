{
  "_spell": "cspell:ignore .",
  "base": "main",
  "php": "8.4",
  "chain": false,
  "jobs": [
    {
      "name": "lint",
      "run": "php -l",
      "each": [
        "**/*.php",
        "!vendor/**"
      ],
      "always": true
    },
    {
      "name": "lint-floor",
      "run": "php -l",
      "php": "8.2",
      "each": [
        "**/*.php",
        "!vendor/**",
        "!tests/**"
      ],
      "always": true
    },
    {
      "name": "synced-files",
      "run": "node .claude/skills/synced-files/scripts/check-synced-files.mjs",
      "always": true,
      "requires": [
        "bin:node"
      ]
    },
    {
      "name": "download-archive",
      "run": "node .claude/skills/download-archive-check/check-download-archive.mjs",
      "always": true,
      "requires": [
        "bin:node",
        "bin:git"
      ]
    },
    {
      "name": "pint",
      "run": "vendor/bin/pint --test",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "pint.json"
      ]
    },
    {
      "name": "rector",
      "run": "vendor/bin/rector --dry-run",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "rector.php",
        "composer.lock"
      ]
    },
    {
      "name": "phpstan",
      "run": "composer stan",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "phpstan.neon.dist",
        "composer.lock"
      ]
    },
    {
      "name": "pest",
      "run": "vendor/bin/pest",
      "paths": [
        "**/*.php",
        "!vendor/**",
        "phpunit.xml*",
        "composer.lock"
      ]
    }
  ]
}
